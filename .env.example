# Port du serveur (site + API). Doit correspondre au port exposé dans Dokploy.
PORT=5173

# Interface d'écoute. 0.0.0.0 est requis en conteneur.
HOST=0.0.0.0

# --- Sarbacane -------------------------------------------------------
# Endpoint de la liste qui reçoit les leads du formulaire.
CONTACT_WEBHOOK_URL=https://sarbacaneapis.com/v1/lists/VOTRE_LIST_ID/contacts

# Sarbacane exige DEUX en-têtes : accountId et apiKey.
# Surtout pas Authorization / Bearer.
# Clé à générer dans Sarbacane : Paramètres du compte > API.
SARBACANE_ACCOUNT_ID=
SARBACANE_API_KEY=

# Optionnel : l'ID de liste est déduit de CONTACT_WEBHOOK_URL.
# Ne le renseigner que pour forcer une autre liste.
# SARBACANE_LIST_ID=

# Optionnel : correspondance explicite entre les champs du formulaire et
# les IDs des champs personnalisés Sarbacane. Sans cette variable, les IDs
# sont découverts automatiquement via GET /v1/lists/{id}/fields.
# SARBACANE_FIELDS={"company":"idChamp1","name":"idChamp2","message":"idChamp3"}

# --- Divers ----------------------------------------------------------
# Origines autorisées pour le CORS (inutile si le formulaire est servi par
# ce même serveur). Ajoutez le domaine de production si besoin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sans API configurée : "log" enregistre la demande, "error" renvoie une erreur.
CONTACT_FALLBACK_MODE=log

# true = renvoyer une erreur au visiteur si Sarbacane refuse l'envoi.
# false (défaut) = le lead est conservé dans data/leads.jsonl et le visiteur
# reçoit une confirmation, car sa demande n'est pas perdue.
CONTACT_STRICT=false

# Emplacement du journal local des leads (filet de sécurité).
# En conteneur, pointez-le vers un volume persistant.
# LEADS_FILE=/app/data/leads.jsonl
