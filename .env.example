# Port du serveur local (site + API)
PORT=5173

# Provider : sarbacane | webhook (auto-détecté si URL sarbacaneapis.com)
CONTACT_PROVIDER=sarbacane

# --- Sarbacane (https://sarbacaneapis.com/v1/) ---
# Identifiants : Paramètres > API dans Sarbacane Suite
SARBACANE_ACCOUNT_ID=
SARBACANE_LIST_ID=
CONTACT_API_KEY=

# Optionnel : URL de base (sinon construite depuis SARBACANE_LIST_ID)
CONTACT_WEBHOOK_URL=https://sarbacaneapis.com/v1

# --- Webhook générique (si CONTACT_PROVIDER=webhook) ---
# CONTACT_WEBHOOK_URL=https://api.example.com/v1/contact-leads
# CONTACT_API_HEADER=Authorization
# CONTACT_API_KEY_PREFIX=Bearer

# Origines autorisées pour les requêtes CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Si aucune API : log (dev) ou error
CONTACT_FALLBACK_MODE=log
