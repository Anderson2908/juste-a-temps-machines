# Port du serveur local (site + API)
PORT=5173

# URL de votre API / webhook pour recevoir les demandes de contact
# Exemple : https://api.example.com/v1/contact-leads
CONTACT_WEBHOOK_URL=

# Clé ou token envoyé à votre API (optionnel)
CONTACT_API_KEY=

# Nom du header d'authentification (par défaut Authorization)
# Exemples : Authorization, X-API-Key
CONTACT_API_HEADER=Authorization

# Préfixe du token si vous utilisez Authorization (ex. Bearer)
CONTACT_API_KEY_PREFIX=Bearer

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Si aucune API n'est configurée : "log" enregistre en console, "error" renvoie une erreur
CONTACT_FALLBACK_MODE=log
